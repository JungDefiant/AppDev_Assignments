# Copy this file to server/.env and change the values before running.

# REQUIRED for anything beyond a local demo. 64+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please-change-me-to-a-long-random-string

# Port the API listens on (default 4000)
PORT=4000

# Secret code required to self-register an Admin account.
# The FIRST account ever registered is always auto-promoted to Admin (bootstrap).
ADMIN_SIGNUP_CODE=AD371-ADMIN-DEMO-CODE
