###############################################################################
# TLS material for the load balancer's 443 listener.
#
# A self-signed certificate is generated by Terraform (no secrets are checked
# in). Both the certificate and private key are injected directly into the
# nginx container via `upload` blocks in containers.tf.
###############################################################################

resource "tls_private_key" "lb_tls" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "tls_self_signed_cert" "lb_tls" {
  private_key_pem       = tls_private_key.lb_tls.private_key_pem
  validity_period_hours = 8760 # 1 year, fine for a lab/demo certificate

  subject {
    common_name  = "multisubnet-lb.local"
    organization = "AD371"
  }

  dns_names    = ["localhost", "multisubnet-lb.local"]
  ip_addresses = ["127.0.0.1"]

  allowed_uses = ["key_encipherment", "digital_signature", "server_auth"]
}
