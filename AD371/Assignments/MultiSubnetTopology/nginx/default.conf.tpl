# =============================================================================
# Generated by Terraform (templatefile) - do not edit manually.
#
# Reverse-proxy load balancer configuration.
#
# UPSTREAM POOL: the backend replicas from BOTH apps (Node.js `backend-N` and
# Python `pybackend-N`), all reachable ONLY on the internal private subnet
# (Docker DNS resolves these names to container IPs).
#
# nginx's default scheduling algorithm for an upstream group is Round-Robin,
# which is exactly what this topology requires (note: no `least_conn`,
# `ip_hash`, random, or weights are configured).
# =============================================================================

upstream app_backend {
%{~ for upstream in upstreams }
    server ${upstream} max_fails=3 fail_timeout=15s;
%{~ endfor }
}

# -----------------------------------------------------------------------------
# HTTP listener (host port ${http_port} -> container port 80)
# -----------------------------------------------------------------------------
server {
    listen 80;
    server_name _;

    # Fail over fast: a dead backend's IP silently drops packets (no TCP RST),
    # so without a short connect timeout nginx would stall up to 60s before
    # retrying the next peer in the pool.
    proxy_connect_timeout 2s;
    proxy_read_timeout    10s;
    proxy_send_timeout    10s;

    # Health-check endpoint, passed straight through to the backend pool.
    location = /healthz {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# -----------------------------------------------------------------------------
# HTTPS listener (host port ${https_port} -> container port 443)
# Certificate/key are generated by Terraform and uploaded into the container.
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    server_name _;

    # Fast failover (see the HTTP listener above for rationale).
    proxy_connect_timeout 2s;
    proxy_read_timeout    10s;
    proxy_send_timeout    10s;

    ssl_certificate     /etc/nginx/certs/lb.crt;
    ssl_certificate_key /etc/nginx/certs/lb.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location = /healthz {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
