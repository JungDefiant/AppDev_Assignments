# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and adjust as needed:
#   cp .env.example .env
#
# `docker compose` loads `.env` automatically:
#   1. For variable substitution in docker-compose.yml (e.g. ${GATEWAY_PORT}).
#   2. As the container environment via `env_file: .env` on the web service.
# NEVER commit the real `.env` (it is .gitignored / .dockerignored).
# ---------------------------------------------------------------------------

# --- Application settings (injected into the web containers) --------------
NODE_ENV=production
APP_NAME=OCI Container Demo
GREETING=Hello from a hardened, non-root Alpine container

# --- Compose variable substitution ----------------------------------------
# Host port the nginx gateway publishes (container port stays fixed at 80).
GATEWAY_PORT=8080
