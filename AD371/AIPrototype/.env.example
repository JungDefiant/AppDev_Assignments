# Server
PORT=3000

# Discourse instance (used to build deep links back to posts)
DISCOURSE_URL=https://forum.example.com

# Optional: secret configured on the Discourse webhook, used to verify the
# X-Discourse-Event-Signature header (HMAC-SHA256 of the raw request body)
DISCOURSE_WEBHOOK_SECRET=

# Comma-separated list of X-Discourse-Event values to forward to Slack
DISCOURSE_EVENTS=post_created

# Slack incoming webhook URL (from https://api.slack.com/apps -> Incoming Webhooks)
SLACK_WEBHOOK_URL=

# Optional overrides
SLACK_CHANNEL=
SLACK_USERNAME=Discourse Notifier

# Set to 1 to log Slack messages instead of delivering them (local testing)
MOCK_SLACK=0
